table fato_estoque_diario
	lineageTag: 7b8100f6-3540-43b9-9011-0a115359f12c

	measure 'Data de referência' =
			VAR Primeira = MIN(dim_data[dt_data])
			VAR Selecionada = MAX(dim_data[dt_data])
			VAR Carga = CALCULATE(MAX(fato_estoque_diario[dt_estoque]), REMOVEFILTERS())
			RETURN IF(Primeira > Carga, BLANK(), MIN(Selecionada, Carga))
		formatString: dd/MM/yyyy
		displayFolder: Estoque
		lineageTag: 8b3b5787-cfa6-41ff-80f0-f2c7deff7566

	measure 'Valor do estoque' =
			VAR Ref = [Data de referência]
			RETURN IF(ISBLANK(Ref), BLANK(), CALCULATE(SUM(fato_estoque_diario[vl_estoque_final]), REMOVEFILTERS(dim_data), dim_data[dt_data] = Ref))
		formatString: R$ #,0.00
		displayFolder: Estoque
		lineageTag: cf271c59-fe94-463c-b348-629af8d274b1

	measure 'Saldo em unidades' =
			VAR Ref = [Data de referência]
			RETURN IF(ISBLANK(Ref), BLANK(), CALCULATE(SUM(fato_estoque_diario[qt_saldo_final]), REMOVEFILTERS(dim_data), dim_data[dt_data] = Ref))
		formatString: #,0
		displayFolder: Estoque
		lineageTag: 1b69b447-e19a-4f2d-84df-46e0af8d697d

	measure 'Compra pendente em unidades' =
			VAR Ref = [Data de referência]
			RETURN IF(ISBLANK(Ref), BLANK(), CALCULATE(SUM(fato_estoque_diario[qt_compra_pendente]), REMOVEFILTERS(dim_data), dim_data[dt_data] = Ref))
		formatString: #,0
		displayFolder: Estoque
		lineageTag: 7482c0eb-af9c-4636-8097-1fe743132b2d

	measure 'Combinações em risco' =
			VAR Ref = [Data de referência]
			RETURN IF(ISBLANK(Ref), BLANK(), CALCULATE(SUM(fato_estoque_diario[in_risco_espera]), REMOVEFILTERS(dim_data), dim_data[dt_data] = Ref))
		formatString: #,0
		displayFolder: Estoque
		lineageTag: 0be61028-4db0-4eec-beff-23a03bf05918

	measure 'Combinações sem saída' =
			VAR Ref = [Data de referência]
			RETURN IF(ISBLANK(Ref), BLANK(), CALCULATE(SUM(fato_estoque_diario[in_sem_saida]), REMOVEFILTERS(dim_data), dim_data[dt_data] = Ref))
		formatString: #,0
		displayFolder: Estoque
		lineageTag: 6328a59a-f02f-4d58-86ab-6abd88c43e7c

	measure 'Combinações com cobertura elevada' =
			VAR Ref = [Data de referência]
			RETURN IF(ISBLANK(Ref), BLANK(), CALCULATE(SUM(fato_estoque_diario[in_cobertura_elevada]), REMOVEFILTERS(dim_data), dim_data[dt_data] = Ref))
		formatString: #,0
		displayFolder: Estoque
		lineageTag: db9f0738-14fb-4258-8292-ce2b2a242703

	measure 'Combinações sem saldo' =
			VAR Ref = [Data de referência]
			RETURN IF(ISBLANK(Ref), BLANK(), CALCULATE(SUM(fato_estoque_diario[in_indisponivel]), REMOVEFILTERS(dim_data), dim_data[dt_data] = Ref))
		formatString: #,0
		displayFolder: Estoque
		lineageTag: 43b083d6-5732-4ee8-8ddf-75b5812a6bcc

	measure 'Combinações para repor' =
			VAR Ref = [Data de referência]
			RETURN IF(ISBLANK(Ref), BLANK(), CALCULATE(SUM(fato_estoque_diario[in_reposicao]), REMOVEFILTERS(dim_data), dim_data[dt_data] = Ref))
		formatString: #,0
		displayFolder: Estoque
		lineageTag: 3902571a-caed-4dc7-b3d4-6872170acde3

	measure 'Demanda média diária' =
			VAR Ref = [Data de referência]
			RETURN IF(ISBLANK(Ref), BLANK(), CALCULATE(SUM(fato_estoque_diario[qt_demanda_media_dia]), REMOVEFILTERS(dim_data), dim_data[dt_data] = Ref))
		formatString: #,0.00
		displayFolder: Estoque
		lineageTag: 2b7063d6-02e4-4c3a-856f-dbb87f2fef6b

	measure 'Ponto de reposição' =
			VAR Ref = [Data de referência]
			RETURN IF(ISBLANK(Ref), BLANK(), CALCULATE(SUM(fato_estoque_diario[qt_ponto_reposicao]), REMOVEFILTERS(dim_data), dim_data[dt_data] = Ref))
		formatString: #,0
		displayFolder: Estoque
		lineageTag: 4f427716-2eaf-40c6-88da-092e163afb59

	measure 'Cobertura em dias' = IF(HASONEVALUE(dim_produto[id_produto]) && HASONEVALUE(dim_centro_distribuicao[id_centro_distribuicao]), DIVIDE([Saldo em unidades], [Demanda média diária]))
		formatString: #,0.0
		displayFolder: Estoque
		lineageTag: 2be1db6b-6759-488d-a585-0acdb500cf26

	measure 'Situação do estoque' =
			VAR Ref = [Data de referência]
			RETURN IF(HASONEVALUE(dim_produto[id_produto]) && HASONEVALUE(dim_centro_distribuicao[id_centro_distribuicao]), CALCULATE(SELECTEDVALUE(fato_estoque_diario[tx_situacao_estoque]), REMOVEFILTERS(dim_data), dim_data[dt_data] = Ref))
		displayFolder: Estoque
		lineageTag: caec49ff-c244-4516-8b39-3a52ed751649

	measure 'Unidades expedidas' = CALCULATE(SUM(fato_movimento_estoque[qt_movimento]), dim_tipo_movimento[cd_tipo_movimento] = "EXPEDICAO")
		formatString: #,0
		displayFolder: Operação
		lineageTag: d2289f7c-ee20-4cc9-b289-963364d9effa

	measure 'Custo das expedições' = -CALCULATE(SUM(fato_movimento_estoque[vl_movimento_assinado]), dim_tipo_movimento[cd_tipo_movimento] = "EXPEDICAO")
		formatString: R$ #,0.00
		displayFolder: Operação
		lineageTag: e6d41ab5-cd83-47f0-a1d7-b1280960195b

	measure 'Valor comprado' = SUM(fato_item_compra[vl_total_item])
		formatString: R$ #,0.00
		displayFolder: Compras
		lineageTag: 49d67218-c358-414d-b476-e0165aefa9e4

	measure 'Pedidos emitidos' = DISTINCTCOUNT(fato_item_compra[nr_pedido])
		formatString: #,0
		displayFolder: Compras
		lineageTag: 64b9b9e8-3341-41d3-9e83-4ccbb7a9d5f9

	measure 'Valor recebido' = SUM(fato_recebimento[vl_total_recebido])
		formatString: R$ #,0.00
		displayFolder: Compras
		lineageTag: 2ae43211-60a9-401c-a93b-46a907128286

	measure 'Unidades recebidas' = SUM(fato_recebimento[qt_recebida])
		formatString: #,0
		displayFolder: Compras
		lineageTag: e2dbb1e4-c87f-4b5e-a7f4-3f2b87c8128d

	measure 'Itens vencidos no corte final' = SUM(fato_item_compra[in_vencido_ate_referencia])
		formatString: #,0
		displayFolder: Fornecedores • posição final
		lineageTag: 893fc11c-f963-488e-9b96-34dae25c2011

	measure 'Itens integrais no prazo' = SUM(fato_item_compra[in_integral_no_prazo])
		formatString: #,0
		displayFolder: Fornecedores • posição final
		lineageTag: fd8f6db3-6f3d-4a2d-9696-8f7c84e6b46d

	measure 'Pontualidade no corte final' = DIVIDE([Itens integrais no prazo], [Itens vencidos no corte final])
		formatString: 0.0%
		displayFolder: Fornecedores • posição final
		lineageTag: a1621455-238b-4817-89b2-d46489ec2c4c

	measure 'Itens pendentes atrasados' = SUM(fato_item_compra[in_pendente_atrasado])
		formatString: #,0
		displayFolder: Fornecedores • posição final
		lineageTag: e6efaaf2-04a1-4b89-81a3-7ff5f4751652

	measure 'Prazo médio de entrega (dias)' = AVERAGE(fato_item_compra[nr_dias_entrega_completa])
		formatString: #,0.0
		displayFolder: Fornecedores • posição final
		lineageTag: 25d7e52a-9e1e-41a4-974a-7179b5ebcb4d

	measure 'Unidades ajustadas' = CALCULATE(SUM(fato_movimento_estoque[qt_movimento]), dim_tipo_movimento[cd_tipo_movimento] IN {"AJUSTE_POSITIVO", "AJUSTE_NEGATIVO"})
		formatString: #,0
		displayFolder: Operação
		lineageTag: ac405bce-cc63-48ea-9c5f-18355886dcfb

	measure 'Valor líquido dos ajustes' = CALCULATE(SUM(fato_movimento_estoque[vl_movimento_assinado]), dim_tipo_movimento[cd_tipo_movimento] IN {"AJUSTE_POSITIVO", "AJUSTE_NEGATIVO"})
		formatString: R$ #,0.00
		displayFolder: Operação
		lineageTag: c67c0590-8155-41cd-848d-655b101464cc

	measure 'Quantidade movimentada' = SUM(fato_movimento_estoque[qt_movimento])
		formatString: #,0
		displayFolder: Operação
		lineageTag: fadaeb1d-0e67-43f8-bdbc-c363e03d0bb0

	measure 'Valor líquido movimentado' = SUM(fato_movimento_estoque[vl_movimento_assinado])
		formatString: R$ #,0.00
		displayFolder: Operação
		lineageTag: fc3838d4-aff9-4e6b-a830-2d39e36e6a00

