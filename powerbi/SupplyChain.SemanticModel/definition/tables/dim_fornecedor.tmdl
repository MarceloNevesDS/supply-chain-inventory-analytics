				  Tipos = Table.TransformColumnTypes(Nulos, {{"id_fornecedor", Int64.Type}, {"cd_fornecedor", type text}, {"nm_fornecedor", type text}, {"nm_cidade", type text}, {"sg_uf", type text}, {"nm_regiao", type text}}, "en-US")
